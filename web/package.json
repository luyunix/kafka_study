{
  "name": "kafka-study-github-pages",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "generate:content": "node scripts/generate-course-data.mjs",
    "dev": "npm run generate:content && next dev",
    "build": "npm run generate:content && next build",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/kafka_study GITHUB_PAGES=true npm run build",
    "start": "next start",
    "test": "npm run build:pages",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "mermaid": "^11.16.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
